# Backend
PORT=5000
NODE_ENV=development

# Demo mode - set to "true" to simulate Razorpay without real keys
DEMO_MODE=true

# Supabase (enter your values)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Razorpay Test Mode (not needed when DEMO_MODE=true)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
