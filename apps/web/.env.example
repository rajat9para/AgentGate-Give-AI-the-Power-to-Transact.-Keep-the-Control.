# ============================================================
# AgentGate — Frontend Web Environment Variables (Vercel / Local)
# NOTE: ONLY EXPOSE VARIABLES THAT ARE SAFE FOR THE BROWSER
# NEVER EXPOSE SERVICE-ROLE KEYS, SIGNING KEYS, OR RAZORPAY SECRETS
# ============================================================

# Backend API Base URL (Points to Render in production)
VITE_API_BASE_URL=http://localhost:5000/api

# Public App Origin
VITE_APP_URL=http://localhost:5173

# Public Supabase Client (Anon Key Only - RLS Enforced)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Public Razorpay Key ID (For checkout popup if enabled)
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key_id_here

# Public Cloudinary Configuration (For direct browser uploads & rendering)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=agentgate
